<Project>

	<!-- Applies to every project in the repo (src, tests, samples). -->
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AnalysisLevel>latest-recommended</AnalysisLevel>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>helvy91</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/helvy91/PrestaKit</PackageProjectUrl>
		<RepositoryUrl>https://github.com/helvy91/PrestaKit</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Description>A modern, typed .NET client for the PrestaShop webservice API.</Description>
		<PackageTags>prestashop;ecommerce;api-client;webservice</PackageTags>

		<Version>0.2.1</Version>

		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PrestaKit.Tests" />
		<InternalsVisibleTo Include="PrestaKit.IntegrationTests" />
	</ItemGroup>

</Project>
